          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "one_of"
              ]
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/AttributeValue"
              },
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "description": "Inclusive endpoints; at least one must be supplied.",
          "required": [
            "op"
          ],
          "properties": {
            "max": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/components/schemas/AttributeValue"
                }
              ]
            },
            "min": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/components/schemas/AttributeValue"
                }
              ]
            },
            "op": {
              "type": "string",
              "enum": [
                "range"
              ]
            }
          }
        }
      ]
    },
    "propertyNames": {
      "type": "string"
    }
  },
