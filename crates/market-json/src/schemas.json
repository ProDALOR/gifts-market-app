{
  "Item": {
    "type": "object",
    "required": [
      "item_id",
      "attributes",
      "feed_id",
      "item_type_id",
      "observed_at"
    ],
    "properties": {
      "attributes": {
        "type": "object",
        "additionalProperties": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ]
        }
      },
      "feed_id": {
        "type": "string"
      },
      "item_id": {
        "$ref": "#/components/schemas/ItemId",
        "description": "Opaque item identity; adapters establish cross-venue identity explicitly."
      },
      "item_type_id": {
        "type": "string"
      },
      "observed_at": {
        "type": "string",
        "format": "date-time",
        "description": "A checked Jiff timestamp at the precision supported by the wire contract.\n\nSerde uses UTC RFC 3339 strings. Protobuf conversions explicitly use whole\nmilliseconds. Constructing from a finer-precision Jiff value fails rather\nthan silently changing the instant.\nUnknown source times are `Option<MarketTimestamp>`, never a zero sentinel."
      }
    },
    "additionalProperties": false
  },
  "ItemId": {
    "type": "string"
  },
  "Order": {
    "type": "object",
    "required": [
      "order_id",
      "kind",
      "price",
      "quantity",
      "feed_id",
      "item_type_id",
      "observed_at"
    ],
    "properties": {
      "expires_at": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "$ref": "#/components/schemas/MarketTimestamp"
          }
        ]
      },
      "feed_id": {
        "type": "string"
      },
      "item_type_id": {
        "type": "string"
      },
      "kind": {
        "$ref": "#/components/schemas/OrderKind",
        "description": "Determines the side; the common envelope cannot declare a conflicting side."
      },
      "meta": {
        "type": "object",
        "description": "Opaque source metadata; keys are case-sensitive and contain no whitespace or controls. Limits: 16 entries, 64 UTF-8 bytes per key, 2048 per value, 4096 combined key/value bytes. Empty maps are omitted.",
        "additionalProperties": {
          "type": "string"
        },
        "maxProperties": 16
      },
      "observed_at": {
        "type": "string",
        "format": "date-time",
        "description": "A checked Jiff timestamp at the precision supported by the wire contract.\n\nSerde uses UTC RFC 3339 strings. Protobuf conversions explicitly use whole\nmilliseconds. Constructing from a finer-precision Jiff value fails rather\nthan silently changing the instant.\nUnknown source times are `Option<MarketTimestamp>`, never a zero sentinel."
      },
      "order_id": {
        "$ref": "#/components/schemas/OrderId"
      },
      "price": {
        "$ref": "#/components/schemas/Money",
        "description": "Price per whole unit; limit price on an order, actual price on an execution."
      },
      "quantity": {
        "$ref": "#/components/schemas/Quantity",
        "description": "Remaining on an order, executed on a trade. Always positive and exact."
      }
    },
    "additionalProperties": false
  },
  "MarketTimestamp": {
    "type": "string",
    "format": "date-time",
    "description": "A checked Jiff timestamp at the precision supported by the wire contract.\n\nSerde uses UTC RFC 3339 strings. Protobuf conversions explicitly use whole\nmilliseconds. Constructing from a finer-precision Jiff value fails rather\nthan silently changing the instant.\nUnknown source times are `Option<MarketTimestamp>`, never a zero sentinel."
