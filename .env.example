# Obtain with market-hub token --id market-app.
MARKET_NODE_TOKEN=
MARKET_CORE_URL=http://market-hub:50051
# Optional: MARKET_NETWORK=market
# Optional: MARKET_APP_PORT=8080

# Native runs only: MARKET_DATA_DIR=data (Compose uses its /data volume).

# Optional Telegram integration. Public HTTPS URL is required to launch inside Telegram.
# MARKET_TELEGRAM_BOT_ID=123456789
# MARKET_TELEGRAM_BOT_USERNAME=your_bot
# MARKET_PUBLIC_URL=https://markets.example.com
# Only the optional bot worker receives this credential:
# TELEGRAM_BOT_TOKEN=
# Multiple API replicas should share a key from: market-app session-key
# MARKET_SESSION_KEY=
