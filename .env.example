# Docker Compose. Native runs and advanced settings: README.md.
# Issue a service token with: market-hub token --id market-app
MARKET_HUB_URL=
MARKET_HUB_TOKEN=

# Optional Docker overrides.
# MARKET_APP_PORT=8080
# Existing Docker network shared with the hub; defaults to market.
# For a hub on this network, set MARKET_HUB_URL=http://market-hub:50051.
# MARKET_NETWORK=market

# Optional Telegram bot worker (support is included in the image).
# API ID/hash: my.telegram.org. Bot token: @BotFather.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_BOT_TOKEN=

# Optional public HTTPS origin for the Mini App.
# MARKET_PUBLIC_URL=https://markets.example.com
# Bot identity is discovered after authentication.

# Mini App-only identity, session keys and server tuning: README.md.
