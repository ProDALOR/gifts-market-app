# Obtain with market-hub token --id market-app.
MARKET_HUB_TOKEN=
MARKET_HUB_URL=http://market-hub:50051
# Optional Compose settings:
# MARKET_NETWORK=market
# MARKET_APP_PORT=8080
# MARKET_APP_IMAGE=market-app:local
# Headless image skips Node/frontend entirely:
# MARKET_IMAGE_TARGET=market-api
# Disable frontend routes in the ordinary image:
# MARKET_NO_WEB=true

# Optional server settings (CLI flags override environment values):
# Native listener; Docker binds 0.0.0.0:8080:
# MARKET_HTTP_ADDR=127.0.0.1:8080
# MARKET_WEB_DIR=web/dist
# MARKET_CORS_ORIGINS=https://markets.example.com,https://another.example.com
# MARKET_HTTP_WORKERS=2
# MARKET_MAX_CONCURRENT_QUERIES=32
# Distinct shared query feeds, not connections:
# MARKET_MAX_LIVE_QUERIES=128
# Native replica directory; container uses /data:
# MARKET_DATA_DIR=data
# Optional persistent model/pattern media cache; default: <MARKET_DATA_DIR>/media.
# Compose default: /data/media. Custom container paths need a writable mount.
# MARKET_MEDIA_DIR=data/media
# API-only nodes: optional Telegram-enabled market API origin for uncached media.
# Use a separate local cache per node; leave unset when the local bot is enabled.
# MARKET_MEDIA_ORIGIN=https://media.example.com
# RUST_LOG=info

# Optional Cargo features (Compose build argument). Default has no Telegram support.
# MARKET_FEATURES=bot,miniapp
# Native: cargo run -p market-app --features bot,miniapp
# Public HTTPS origin is required for Telegram launch buttons.
# MARKET_PUBLIC_URL=https://markets.example.com
# Enable the MTProto worker on exactly one application instance:
# MARKET_BOT_ENABLED=true
# Private credentials for the enabled instance (API ID/hash from my.telegram.org):
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_BOT_TOKEN=
# Bot ID and username are discovered after authentication. Do not configure them here.
# Native bot default: <MARKET_DATA_DIR>/bot; container: /bot-data.
# MARKET_BOT_DATA_DIR=bot-data

# Mini App deployments WITHOUT a bot worker (including API replicas):
# MARKET_MINIAPP_BOT_ID=123456789
# MARKET_MINIAPP_BOT_USERNAME=your_bot
# Mini App replicas should share a key from: market-app session-key (miniapp feature).
# A single instance generates/preserves <MARKET_DATA_DIR>/session.key automatically.
# MARKET_SESSION_KEY=
