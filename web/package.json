{
  "name": "market-app-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "npm run generate && vite --host 127.0.0.1",
    "build": "npm run generate && tsc --noEmit && vite build",
    "test": "node --experimental-transform-types --test scripts/*.test.ts",
    "benchmark:query": "node --experimental-transform-types scripts/query-benchmark.mjs",
    "benchmark:previews": "node scripts/preview-benchmark.mjs",
    "validate:previews": "node scripts/svg-validation.mjs",
    "test:previews": "node scripts/preview-browser.mjs",
    "test:placeholders": "node scripts/placeholder-browser.mjs",
    "test:media-retries": "node scripts/media-retry-browser.mjs",
    "test:icons": "node scripts/shared-icons-browser.mjs",
    "test:orderbook": "node scripts/orderbook-browser.mjs",
    "test:grid": "node scripts/grid-browser.mjs",
    "test:traits": "node scripts/trait-preview-browser.mjs",
    "test:listings": "node scripts/listing-browser.mjs",
    "test:preview-facts": "node scripts/preview-facts-browser.mjs",
    "test:bids": "node scripts/bid-browser.mjs",
    "test:live-feed": "node scripts/live-feed-browser.mjs",
    "test:strategy-inputs": "node scripts/strategy-inputs-browser.mjs",
    "test:attribute-values": "node scripts/attribute-values-browser.mjs",
    "test:rarity": "node scripts/rarity-browser.mjs",
    "test:portfolio": "node scripts/portfolio-browser.mjs",
    "test:navigation": "node scripts/navigation-browser.mjs",
    "test:telegram": "node scripts/telegram-browser.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "katex": "0.19.1",
    "lottie-web": "^5.13.0",
    "micromark": "4.0.3",
    "micromark-extension-math": "3.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@asyncapi/parser": "3.6.6",
    "@scalar/api-reference": "1.80.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "openapi-typescript": "^7",
    "playwright": "^1.65.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "zod": "4.6.7"
  },
  "overrides": {
    "katex": "$katex"
  }
}
