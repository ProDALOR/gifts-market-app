# Build only service sources; credentials and local state stay outside the image context.
**
!Dockerfile
!Cargo.toml
!Cargo.lock
!market-hub.proto
!licenses/
!licenses/NotoSans-OFL.txt
!licenses/velato/
!licenses/velato/**
# Cargo validates declared test and example paths even when building only binaries.
!crates/
!crates/**
**/target/

!web/
!web/**
web/node_modules/
web/dist/
web/src/gen/
**/*.mtproto.sqlite*
**/accounts.json
**/.env*
**/*.key
**/*.pem

# Runtime thumbnail payloads and incomplete cache writes.
**/*.thumb
**/*.tgs
!web/src/brand/liberty-figure.tgs
**/*.part
