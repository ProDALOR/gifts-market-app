# Build only service sources; credentials and local state stay outside the image context.
**
!Dockerfile
!Cargo.toml
!Cargo.lock
!market-hub.proto
!crates/
!crates/**
**/tests/
**/examples/
**/target/

!web/
!web/**
web/node_modules/
web/dist/
web/src/gen/
**/*.mtproto.sqlite*
**/.env
**/.env.*

# Runtime thumbnail payloads and incomplete cache writes.
**/*.thumb
**/*.tgs
**/*.part
